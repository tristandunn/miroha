{
  "extends": [
    "stylelint-config-standard"
  ],
  "rules": {
    "at-rule-no-deprecated": null,
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "apply",
          "plugin"
        ]
      }
    ],
    "at-rule-prelude-no-invalid": [
      true,
      {
        "ignoreAtRules": [
          "apply",
          "media"
        ]
      }
    ],
    "import-notation": "string"
  }
}
