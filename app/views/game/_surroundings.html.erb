<%# locals: (room:) %>
<div id="surroundings" class="bg-gray-800">
  <ol id="surrounding-npcs">
    <%= render partial: "game/surroundings/npc", collection: room.npcs.sort_by(&:name) %>
  </ol>

  <ol id="surrounding-monsters">
    <%= render partial: "game/surroundings/monster", collection: room.monsters.sort_by(&:name) %>
  </ol>

  <ol id="surrounding-items">
    <%= render partial: "game/surroundings/item", collection: room.items.sort_by(&:name) %>
  </ol>

  <ol id="surrounding-characters">
    <%= render partial:    "game/surroundings/character",
               collection: room.characters.active.sort_by(&:name) %>
  </ol>
</div>
